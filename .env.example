NEXT_PUBLIC_API_BASE=/api
BACKEND_API_URL=http://localhost:4007/api
NEXT_PUBLIC_FREE_SHIPPING_MINIMUM=299
# Campanha de frete grátis em qualquer valor (padrão: outubro/2026). Use as mesmas datas da API.
NEXT_PUBLIC_FREE_SHIPPING_PROMO_STARTS_AT=2026-10-01T00:00:00-03:00
NEXT_PUBLIC_FREE_SHIPPING_PROMO_ENDS_AT=2026-10-31T23:59:59-03:00
# Black Friday na home (lib/black-friday.ts). Liga sozinha entre as datas; ?bf=1 mostra antes.
NEXT_PUBLIC_BF_ENABLED=true
NEXT_PUBLIC_BF_STARTS_AT=2026-11-24T00:00:00-03:00
NEXT_PUBLIC_BF_ENDS_AT=2026-11-30T23:59:59-03:00
# Maior desconto anunciado ("Até 30% OFF"). Vazio = "Preço de Black".
NEXT_PUBLIC_BF_MAX_PCT=
